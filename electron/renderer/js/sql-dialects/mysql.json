  "snippets": [
    { "label": "SELECT ... FROM", "insertText": "SELECT ${1:*} FROM ${2:table_name}" },
    { "label": "SELECT ... WHERE", "insertText": "SELECT ${1:*} FROM ${2:table_name} WHERE ${3:condition}" },
    { "label": "INSERT INTO", "insertText": "INSERT INTO ${1:table_name} (${2:columns}) VALUES (${3:values})" },
    { "label": "UPDATE ... SET", "insertText": "UPDATE ${1:table_name} SET ${2:column} = ${3:value} WHERE ${4:condition}" },
    { "label": "DELETE FROM", "insertText": "DELETE FROM ${1:table_name} WHERE ${2:condition}" },
    { "label": "CREATE TABLE", "insertText": "CREATE TABLE ${1:table_name} (\n  ${2:id} INT PRIMARY KEY AUTO_INCREMENT,\n  ${3:column} VARCHAR(255)\n)" },
    { "label": "LEFT JOIN", "insertText": "LEFT JOIN ${1:table_name} ${2:alias} ON ${3:condition}" },
    { "label": "INNER JOIN", "insertText": "INNER JOIN ${1:table_name} ${2:alias} ON ${3:condition}" },
    { "label": "GROUP BY ... HAVING", "insertText": "GROUP BY ${1:column} HAVING ${2:condition}" },
    { "label": "ORDER BY", "insertText": "ORDER BY ${1:column} ${2:ASC}" },
    { "label": "CASE WHEN", "insertText": "CASE\n  WHEN ${1:condition} THEN ${2:result}\n  ELSE ${3:default}\nEND" },
    { "label": "CTE (WITH)", "insertText": "WITH ${1:cte_name} AS (\n  ${2:SELECT * FROM table_name}\n)\nSELECT * FROM ${1:cte_name}" },
    { "label": "Window Function", "insertText": "ROW_NUMBER() OVER (PARTITION BY ${1:column} ORDER BY ${2:column})" }
  ]
